<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/hf_ontology/"
     xml:base="http://www.semanticweb.org/hf_ontology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:hf_ontology="http://www.semanticweb.org/hf_ontology#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/hf_ontology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/hf_ontology#causedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hf_ontology#causedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/hf_ontology#causes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#hasActiveError"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#directCause"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hf_ontology#causes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hf_ontology#causes"/>
    


    <!-- http://www.semanticweb.org/hf_ontology#directCause -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hf_ontology#directCause">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/hf_ontology#causedBy"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/hf_ontology#hasActiveError -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/hf_ontology#hasActiveError">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/hf_ontology#directCause"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hf_ontology#event"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/hf_ontology#activeError"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/hf_ontology#contextualFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#contextualFactor">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#factor"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/hf_ontology#personalFactor"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#factor"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/hf_ontology#personalFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#latentError -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#latentError">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#error"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/hf_ontology#activeError"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#error"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/hf_ontology#directCause"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/hf_ontology#organizationalProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/hf_ontology#activeError"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#activeError -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#activeError">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#error"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#complacency -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#complacency">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#personalFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#dirtyDozenEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#dirtyDozenEvent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#event"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/hf_ontology#causedBy"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/hf_ontology#dirtyDozenFactor"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#dirtyDozenFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#dirtyDozenFactor">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#complacency"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#distraction"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#fatigue"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#inadequateNorms"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#lackOfAssertiveness"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#lackOfAwareness"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#lackOfCommunication"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#lackOfKnowledge"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#lackOfParts"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#lackOfTeamwork"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#pressure"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#stress"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#distraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#distraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#personalFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#error -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#error">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#lapse"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#mistake"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#slip"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#violation"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#event -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#event">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/hf_ontology#causedBy"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#error"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#factor"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#organizationalProcess"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/hf_ontology#hasActiveError"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/hf_ontology#activeError"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#factor -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#factor">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/hf_ontology#organizationalProcess"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#fatigue -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#fatigue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#personalFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#humanEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#humanEvent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#event"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/hf_ontology#hasActiveError"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/hf_ontology#activeError"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#event"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#inadequateNorms -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#inadequateNorms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#contextualFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#lackOfAssertiveness -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#lackOfAssertiveness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#personalFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#lackOfAwareness -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#lackOfAwareness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#personalFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#lackOfCommunication -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#lackOfCommunication">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#contextualFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#lackOfKnowledge -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#lackOfKnowledge">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#personalFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#lackOfParts -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#lackOfParts">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#contextualFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#lackOfTeamwork -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#lackOfTeamwork">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#contextualFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#lapse -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#lapse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#error"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#mistake -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#mistake">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#error"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/hf_ontology#violation"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#multiFactorError -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#multiFactorError">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#activeError"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/hf_ontology#directCause"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/hf_ontology#factor"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#organizationalProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#organizationalProcess"/>
    


    <!-- http://www.semanticweb.org/hf_ontology#organizationalRootEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#organizationalRootEvent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#event"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/hf_ontology#causedBy"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/hf_ontology#organizationalProcess"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#personalFactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#personalFactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#factor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#pressure -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#pressure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#contextualFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#slip -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#slip">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#error"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#stress -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#stress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#personalFactor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#unintendedError -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#unintendedError">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/hf_ontology#error"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/hf_ontology#violation"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/hf_ontology#violation -->

    <owl:Class rdf:about="http://www.semanticweb.org/hf_ontology#violation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hf_ontology#error"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/hf_ontology#ae1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#ae1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#activeError"/>
        <hf_ontology:directCause rdf:resource="http://www.semanticweb.org/hf_ontology#f1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#ev1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#ev1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#event"/>
        <hf_ontology:hasActiveError rdf:resource="http://www.semanticweb.org/hf_ontology#ae1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#f1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#f1">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#fatigue"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#ev3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#ev3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#event"/>
        <hf_ontology:hasActiveError rdf:resource="http://www.semanticweb.org/hf_ontology#ae3a"/>
        <hf_ontology:hasActiveError rdf:resource="http://www.semanticweb.org/hf_ontology#ae3b"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#ae3a -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#ae3a">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#activeError"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#slip"/>
        <hf_ontology:directCause rdf:resource="http://www.semanticweb.org/hf_ontology#lk3"/>
        <hf_ontology:directCause rdf:resource="http://www.semanticweb.org/hf_ontology#pr3"/>
        <hf_ontology:directCause rdf:resource="http://www.semanticweb.org/hf_ontology#lc3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#lk3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#lk3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#lackOfKnowledge"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#pr3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#pr3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#pressure"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#lc3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#lc3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#contextualFactor"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#ae3b -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#ae3b">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#activeError"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#mistake"/>
        <hf_ontology:directCause rdf:resource="http://www.semanticweb.org/hf_ontology#la3"/>
        <hf_ontology:directCause rdf:resource="http://www.semanticweb.org/hf_ontology#cv3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#la3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#la3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#lackOfAwareness"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#cv3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#cv3">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#contextualFactor"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#ev4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#ev4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#event"/>
        <hf_ontology:hasActiveError rdf:resource="http://www.semanticweb.org/hf_ontology#ae4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#ae4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#ae4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#activeError"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#mistake"/>
        <hf_ontology:directCause rdf:resource="http://www.semanticweb.org/hf_ontology#la4"/>
        <hf_ontology:directCause rdf:resource="http://www.semanticweb.org/hf_ontology#pr4"/>
        <hf_ontology:directCause rdf:resource="http://www.semanticweb.org/hf_ontology#cw4"/>
        <hf_ontology:directCause rdf:resource="http://www.semanticweb.org/hf_ontology#le4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#la4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#la4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#lackOfAwareness"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#pr4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#pr4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#pressure"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#cw4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#cw4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#contextualFactor"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#le4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#le4">
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#latentError"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/hf_ontology#mistake"/>
        <hf_ontology:directCause rdf:resource="http://www.semanticweb.org/hf_ontology#op4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/hf_ontology#op4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/hf_ontology#op4">
